&НаКлиенте
Процедура Проверить(Команда)
	ПроверитьНаСервере();
	ПоказатьОповещениеПользователя(ТекстДействий("Проверка выполнена"));
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	ПрименитьНаСервере();
	ПоказатьОповещениеПользователя(ТекстДействий("Настройка применена"));
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуДействий();
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()
	ЗаполнитьТаблицуДействий();
КонецПроцедуры

&НаСервере
Процедура ПрименитьНаСервере()
	УстановитьФлагиУзлов();
	ПрименитьОрганизацию();
	ПрименитьВидДокумента("Договор с поставщиком", Истина, Ложь);
	ПрименитьВидДокумента("Договор с покупателем", Истина, Ложь);
	ПрименитьВидДокумента("Доп. соглашение", Истина, Ложь);
	ПрименитьВидДокумента("Заявка на оплату", Ложь, Истина);
	ЗаполнитьТаблицуДействий();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДействий()
	ТаблицаДействий.Очистить();

	ВыборкаУзлов = ПланыОбмена.ОбменБухгалтерияПредприятияДокументооборот20.Выбрать();
	Если ВыборкаУзлов.Следующий() Тогда
		Узел = ВыборкаУзлов.Ссылка.ПолучитьОбъект();
		ДобавитьДействие("План обмена",
			"ОбменБухгалтерияПредприятияДокументооборот20",
			"ВыгружатьДоговоры=" + ПредставлениеБулево(Узел.ВыгружатьДоговоры) + ", ВыгружатьЗаявкиНаОплату=" + ПредставлениеБулево(Узел.ВыгружатьЗаявкиНаОплату),
			"ВыгружатьДоговоры=Истина, ВыгружатьЗаявкиНаОплату=Истина",
			"Будет обновлено");
	Иначе
		ДобавитьДействие("План обмена",
			"ОбменБухгалтерияПредприятияДокументооборот20",
			"Узел не найден",
			"Требуется создание узла",
			"Пропущено");
	КонецЕсли;

	ПроверитьВидДокумента("Договор с поставщиком", Истина, Ложь);
	ПроверитьВидДокумента("Договор с покупателем", Истина, Ложь);
	ПроверитьВидДокумента("Доп. соглашение", Истина, Ложь);
	ПроверитьВидДокумента("Заявка на оплату", Ложь, Истина);
КонецПроцедуры

&НаСервере
Процедура УстановитьФлагиУзлов()
	ВыборкаУзлов = ПланыОбмена.ОбменБухгалтерияПредприятияДокументооборот20.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		Узел = ВыборкаУзлов.Ссылка.ПолучитьОбъект();
		Если Не Узел.ВыгружатьДоговоры Или Не Узел.ВыгружатьЗаявкиНаОплату Тогда
			Узел.ВыгружатьДоговоры = Истина;
			Узел.ВыгружатьЗаявкиНаОплату = Истина;
			Узел.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПрименитьОрганизацию()
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат;
	КонецЕсли;
	ВыборкаУзлов = ПланыОбмена.ОбменБухгалтерияПредприятияДокументооборот20.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		Узел = ВыборкаУзлов.Ссылка.ПолучитьОбъект();
		НужноЗаписать = Ложь;
		Если Не Узел.ОграничиватьВыгрузкуОрганизациями Тогда
			Узел.ОграничиватьВыгрузкуОрганизациями = Истина;
			НужноЗаписать = Истина;
		КонецЕсли;
		Если НайтиСтрокуОрганизации(Узел, Организация) = Неопределено Тогда
			СтрокаОрганизации = Узел.Организации.Добавить();
			СтрокаОрганизации.Организация = Организация;
			НужноЗаписать = Истина;
		КонецЕсли;
		Если НужноЗаписать Тогда
			Узел.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция НайтиСтрокуОрганизации(Узел, ОрганизацияПоиск)
	Для Каждого СтрокаОрганизации Из Узел.Организации Цикл
		Если СтрокаОрганизации.Организация = ОрганизацияПоиск Тогда
			Возврат СтрокаОрганизации;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ПроверитьВидДокумента(Наименование, ЯвляетсяДоговором, ЯвляетсяЗаявкой)
	СсылкаВида = НайтиВидДокумента(Наименование);
	Если СсылкаВида = Неопределено Тогда
		ДобавитьДействие("Вид документа",
			Наименование,
			"Не найден",
			"ЯвляетсяДоговором=" + ПредставлениеБулево(ЯвляетсяДоговором) + ", ЯвляетсяЗаявкойНаОплату=" + ПредставлениеБулево(ЯвляетсяЗаявкой),
			"Будет создан");
	Иначе
		Вид = СсылкаВида.ПолучитьОбъект();
		ДобавитьДействие("Вид документа",
			Наименование,
			"ЯвляетсяДоговором=" + ПредставлениеБулево(Вид.ЯвляетсяДоговором) + ", ЯвляетсяЗаявкойНаОплату=" + ПредставлениеБулево(Вид.ЯвляетсяЗаявкойНаОплату),
			"ЯвляетсяДоговором=" + ПредставлениеБулево(ЯвляетсяДоговором) + ", ЯвляетсяЗаявкойНаОплату=" + ПредставлениеБулево(ЯвляетсяЗаявкой),
			"Будет обновлено");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПрименитьВидДокумента(Наименование, ЯвляетсяДоговором, ЯвляетсяЗаявкой)
	СсылкаВида = НайтиВидДокумента(Наименование);
	Если СсылкаВида = Неопределено Тогда
		Вид = Справочники.ВидыДокументов.СоздатьЭлемент();
		Вид.Наименование = Наименование;
		Вид.ФормаДокумента = Перечисления.ВариантыФормДокументов.БумажнаяИлиЭлектронная;
		Вид.ЯвляетсяДоговором = ЯвляетсяДоговором;
		Вид.ЯвляетсяЗаявкойНаОплату = ЯвляетсяЗаявкой;
		Вид.Записать();
	Иначе
		Вид = СсылкаВида.ПолучитьОбъект();
		НужноЗаписать = Ложь;
		Если Не ЗначениеЗаполнено(Вид.ФормаДокумента) Тогда
			Вид.ФормаДокумента = Перечисления.ВариантыФормДокументов.БумажнаяИлиЭлектронная;
			НужноЗаписать = Истина;
		КонецЕсли;
		Если Вид.ЯвляетсяДоговором <> ЯвляетсяДоговором Или Вид.ЯвляетсяЗаявкойНаОплату <> ЯвляетсяЗаявкой Тогда
			Вид.ЯвляетсяДоговором = ЯвляетсяДоговором;
			Вид.ЯвляетсяЗаявкойНаОплату = ЯвляетсяЗаявкой;
			НужноЗаписать = Истина;
		КонецЕсли;
		Если НужноЗаписать Тогда
			Вид.Записать();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НайтиВидДокумента(Наименование)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыДокументов КАК ВидыДокументов
	|ГДЕ
	|	ВидыДокументов.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ПредставлениеБулево(Значение)
	Возврат ?(Значение, "Истина", "Ложь");
КонецФункции

&НаСервере
Процедура ДобавитьДействие(Объект, Операция, Текущее, Будет, Статус)
	СтрокаДействия = ТаблицаДействий.Добавить();
	СтрокаДействия.Объект = Объект;
	СтрокаДействия.Операция = Операция;
	СтрокаДействия.Текущее = Текущее;
	СтрокаДействия.Будет = Будет;
	СтрокаДействия.Статус = Статус;
КонецПроцедуры

&НаКлиенте
Функция ТекстДействий(Заголовок)
	Текст = Заголовок + ":";
	Для Каждого СтрокаДействия Из ТаблицаДействий Цикл
		Текст = Текст + Символы.ПС + СтрокаДействия.Объект + ": " + СтрокаДействия.Статус;
	КонецЦикла;
	Возврат Текст;
КонецФункции
