&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Значения по умолчанию
	ОбрабатыватьВходящие = Истина;
	ОбрабатыватьИсходящие = Истина;
	ТолькоПроверка = Истина;
	ОбновитьТаблицу();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицу(Команда)
	Если Не ЗначениеЗаполнено(РабочаяГруппа) Тогда
		Предупреждение("Выберите рабочую группу");
		Возврат;
	КонецЕсли;
	
	ОбновитьТаблицуНаСервере();
КонецПроцедуры

&НаСервере
Функция ОбновитьТаблицуНаСервере()
	// Находим справочник "ВидыДокументов"
	МетаВидов = НайтиСправочникВидовДокументов();
	Если МетаВидов = Неопределено Тогда
		Сообщить("Не найден справочник видов документов");
		Возврат;
	КонецЕсли;
	
	// Атрибуты признаков входящей/исходящей корреспонденции
	АтрВх = НайтиРеквизит(МетаВидов, "ЯвляетсяВходящейКорреспонденцией");
	АтрИсх = НайтиРеквизит(МетаВидов, "ЯвляетсяИсходящейКорреспонденцией");
	
	Если АтрВх = Неопределено И АтрИсх = Неопределено Тогда
		Сообщить("Не найдены реквизиты признаков входящей/исходящей корреспонденции");
		Возврат;
	КонецЕсли;
	
	// Находим справочник "РабочиеГруппы"
	МетаГрупп = НайтиСправочникРабочихГрупп();
	Если МетаГрупп = Неопределено Тогда
		Сообщить("Не найден справочник рабочих групп");
		Возврат;
	КонецЕсли;
	
	// Получаем выбранную группу
	Группа = РабочаяГруппа;
	
	// Запрос к справочнику видов документов
	ЗапросТекст = "ВЫБРАТЬ
	|	ВидДокумента.Ссылка КАК ВидДокумента,
	|	ВидДокумента.Наименование КАК Синоним";
	
	Если АтрВх <> Неопределено Тогда
		ЗапросТекст = ЗапросТекст + ",
	|	ВидДокумента." + АтрВх.Name + " КАК Входящий";
	КонецЕсли;
	
	Если АтрИсх <> Неопределено Тогда
		ЗапросТекст = ЗапросТекст + ",
	|	ВидДокумента." + АтрИсх.Name + " КАК Исходящий";
	КонецЕсли;
	
	ЗапросТекст = ЗапросТекст + "
	|ИЗ
	|	Справочник." + МетаВидов.Name + " КАК ВидДокумента
	|ГДЕ
	|	ВидДокумента.ПометкаУдаления = ЛОЖЬ";
	
	Если ОбрабатыватьВходящие И АтрВх <> Неопределено Тогда
		ЗапросТекст = ЗапросТекст + " И ВидДокумента." + АтрВх.Name + " = ИСТИНА";
	КонецЕсли;
	
	Если ОбрабатыватьИсходящие И АтрИсх <> Неопределено Тогда
		Если ОбрабатыватьВходящие И АтрВх <> Неопределено Тогда
			ЗапросТекст = ЗапросТекст + " ИЛИ";
		КонецЕсли;
		ЗапросТекст = ЗапросТекст + " ВидДокумента." + АтрИсх.Name + " = ИСТИНА";
	КонецЕсли;
	
	Запрос = Новый Запрос(ЗапросТекст);
	Результат = Запрос.Выполнить().Выбрать();
	
	// Создаём табличный документ для вывода
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	// Заголовок
	ТабДок.ВывестиСекцию("Заголовок");
	
	// Шапка таблицы
	ОбластьШапка = ТабДок.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = "№";
	ОбластьШапка.Параметры.ВидДокумента = "Вид документа";
	ОбластьШапка.Параметры.Синоним = "Синоним";
	ОбластьШапка.Параметры.Входящий = "Вх.";
	ОбластьШапка.Параметры.Исходящий = "Исх.";
	ОбластьШапка.Параметры.ГруппаЕсть = "Группа есть";
	ОбластьШапка.Параметры.БудетДобавлена = "Будет добавлена";
	ОбластьШапка.Параметры.Статус = "Статус";
	ТабДок.Вывести(ОбластьШапка);
	
	НомерСтроки = 0;
	Пока Результат.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ГруппаЕсть = ПроверитьГруппуВДоступе(Результат.ВидДокумента, Группа);
		БудетДобавлена = Не ГруппаЕсть;
		
		ОбластьСтрока = ТабДок.ПолучитьОбласть("Строка");
		ОбластьСтрока.Параметры.Номер = НомерСтроки;
		ОбластьСтрока.Параметры.ВидДокумента = Результат.ВидДокумента;
		ОбластьСтрока.Параметры.Синоним = Результат.Синоним;
		
		Если АтрВх <> Неопределено Тогда
			ОбластьСтрока.Параметры.Входящий = ?(Результат.Входящий, "Да", "Нет");
		Иначе
			ОбластьСтрока.Параметры.Входящий = "";
		КонецЕсли;
		
		Если АтрИсх <> Неопределено Тогда
			ОбластьСтрока.Параметры.Исходящий = ?(Результат.Исходящий, "Да", "Нет");
		Иначе
			ОбластьСтрока.Параметры.Исходящий = "";
		КонецЕсли;
		
		ОбластьСтрока.Параметры.ГруппаЕсть = ?(ГруппаЕсть, "Да", "Нет");
		ОбластьСтрока.Параметры.БудетДобавлена = ?(БудетДобавлена, "Да", "Нет");
		
		Если БудетДобавлена Тогда
			ОбластьСтрока.Параметры.Статус = "Будет добавлена";
		Иначе
			ОбластьСтрока.Параметры.Статус = "Уже есть доступ";
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	// Показываем табличный документ
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Защита = Истина;
	ТабДок.Показать("Результат: Виды документов для настройки доступа");
	
	Возврат НомерСтроки;
КонецФункции

&НаСервере
Функция НайтиСправочникВидовДокументов()
	Имена = Новый Массив;
	Имена.Добавить("ВидыДокументов");
	Имена.Добавить("ВидыДокументовДО");
	Имена.Добавить("DocumentTypes");
	
	Для Каждого Имя Из Имена Цикл
		Если Метаданные.Справочники.Найти(Имя) <> Неопределено Тогда
			Возврат Метаданные.Справочники.Найти(Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Спр Из Метаданные.Справочники Цикл
		Если СтрНайти(НРег(Спр.Синоним), "вид документ") > 0 Тогда
			Возврат Спр;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция НайтиСправочникРабочихГрупп()
	Имена = Новый Массив;
	Имена.Добавить("РабочиеГруппы");
	Имена.Добавить("WorkGroups");
	
	Для Каждого Имя Из Имена Цикл
		Если Метаданные.Справочники.Найти(Имя) <> Неопределено Тогда
			Возврат Метаданные.Справочники.Найти(Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Спр Из Метаданные.Справочники Цикл
		Если СтрНайти(НРег(Спр.Синоним), "рабоч группа") > 0 Тогда
			Возврат Спр;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция НайтиРеквизит(МетаОбъект, ЧастьИмени)
	Для Каждого Рекв Из МетаОбъект.Реквизиты Цикл
		Если СтрНайти(НРег(Рекв.Name), НРег(ЧастьИмени)) > 0
			ИЛИ СтрНайти(НРег(Рекв.Синоним), НРег(ЧастьИмени)) > 0 Тогда
			Возврат Рекв;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ПроверитьГруппуВДоступе(ВидДокумента, Группа)
	МР = Метаданные.РегистрыСведений.Найти("ПраваДоступаКДокументам");
	Если МР <> Неопределено Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 КАК Есть
			|ИЗ РегистрСведений." + МР.Name + " КАК П
			|ГДЕ П.ВидДокумента = &Вид И П.Участник = &Группа");
		Запрос.УстановитьПараметр("Вид", ВидДокумента);
		Запрос.УстановитьПараметр("Группа", Группа);
		Рез = Запрос.Выполнить().Выбрать();
		Если Рез.Следующий() Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура Выполнить(Команда)
	Если Не ЗначениеЗаполнено(РабочаяГруппа) Тогда
		Предупреждение("Выберите рабочую группу");
		Возврат;
	КонецЕсли;
	
	Если ТолькоПроверка Тогда
		Сообщить("РЕЖИМ ПРОВЕРКИ: изменения не записываются.");
	КонецЕсли;
	
	ВыполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере()
	Если ТолькоПроверка Тогда
		Возврат;
	КонецЕсли;
	
	Группа = РабочаяГруппа;
	Обработано = 0;
	Ошибок = 0;
	
	МР = Метаданные.РегистрыСведений.Найти("ПраваДоступаКДокументам");
	Если МР = Неопределено Тогда
		Сообщить("ОШИБКА: Не найден регистр «ПраваДоступаКДокументам»");
		Возврат;
	КонецЕсли;
	
	// Перечитываем виды документов (как в ОбновитьТаблицуНаСервере)
	МетаВидов = НайтиСправочникВидовДокументов();
	АтрВх = НайтиРеквизит(МетаВидов, "ЯвляетсяВходящейКорреспонденцией");
	АтрИсх = НайтиРеквизит(МетаВидов, "ЯвляетсяИсходящейКорреспонденцией");
	
	ЗапросТекст = "ВЫБРАТЬ
	|	ВидДокумента.Ссылка КАК ВидДокумента";
	
	Если АтрВх <> Неопределено Тогда
		ЗапросТекст = ЗапросТекст + ",
	|	ВидДокумента." + АтрВх.Name + " КАК Входящий";
	КонецЕсли;
	
	Если АтрИсх <> Неопределено Тогда
		ЗапросТекст = ЗапросТекст + ",
	|	ВидДокумента." + АтрИсх.Name + " КАК Исходящий";
	КонецЕсли;
	
	ЗапросТекст = ЗапросТекст + "
	|ИЗ
	|	Справочник." + МетаВидов.Name + " КАК ВидДокумента
	|ГДЕ
	|	ВидДокумента.ПометкаУдаления = ЛОЖЬ";
	
	Если ОбрабатыватьВходящие И АтрВх <> Неопределено Тогда
		ЗапросТекст = ЗапросТекст + " И ВидДокумента." + АтрВх.Name + " = ИСТИНА";
	КонецЕсли;
	
	Если ОбрабатыватьИсходящие И АтрИсх <> Неопределено Тогда
		Если ОбрабатыватьВходящие И АтрВх <> Неопределено Тогда
			ЗапросТекст = ЗапросТекст + " ИЛИ";
		КонецЕсли;
		ЗапросТекст = ЗапросТекст + " ВидДокумента." + АтрИсх.Name + " = ИСТИНА";
	КонецЕсли;
	
	Запрос = Новый Запрос(ЗапросТекст);
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		ГруппаЕсть = ПроверитьГруппуВДоступе(Результат.ВидДокумента, Группа);
		Если ГруппаЕсть Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Набор = РегистрыСведений[МР.Name].СоздатьНаборЗаписей();
			Набор.Отбор.ВидДокумента.Установить(Результат.ВидДокумента);
			Набор.Отбор.Участник.Установить(Группа);
			Набор.Прочитать();
			
			Если Набор.Количество() = 0 Тогда
				Запись = Набор.Добавить();
				Запись.ВидДокумента = Результат.ВидДокумента;
				Запись.Участник = Группа;
				Запись.Роль = Перечисления.РолиДоступаКДокументам.Чтение;
				Набор.Записать();
				Обработано = Обработано + 1;
			Иначе
				// уже есть
			КонецЕсли;
		Исключение
			Ошибок = Ошибок + 1;
		КонецПопытки;
	КонецЦикла;
	
	// Пересчёт прав
	Попытка
		Если ТипЗнч(Метаданные.ОбщиеМодули.Найти("УправлениеДоступомКДокументам")) <> Тип("Неопределено") Тогда
			Выполнить("УправлениеДоступомКДокументам.ОбновитьПраваДоступа();");
		ИначеЕсли ТипЗнч(Метаданные.ОбщиеМодули.Найти("УправлениеПравамиДоступа")) <> Тип("Неопределено") Тогда
			Выполнить("УправлениеПравамиДоступа.ОбновитьПрава();");
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Сообщить("Готово. Добавлено записей: " + Обработано + ", Ошибок: " + Ошибок);
	// Повторный запуск обновления таблицы для отображения результата
	ОбновитьТаблицуНаСервере();
КонецПроцедуры