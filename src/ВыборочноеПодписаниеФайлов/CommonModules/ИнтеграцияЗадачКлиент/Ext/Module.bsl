////////////////////////////////////////////////////////////////////////////////
// РАСШИРЕНИЕ: ВыборочноеПодписаниеФайлов.
//
// Модуль расширяет общий модуль ИнтеграцияЗадачКлиент основной конфигурации
// (перехват функции ОбработатьДанныеВыполнения) и реализует выборочное
// подписание ЭП отдельных присоединённых файлов документа в процессе
// "Подписание" (задача "Подписать" с результатом "Подписано").
//
// Механизм (штатный, собственная криптография не используется):
//  ИнтеграцияЗадачКлиент.ОбработатьДанныеВыполнения ->
//    ОбработатьДанныеВыполненияПодписатьПредметыЭП ->
//    РаботаСЭПКлиент.Подписать(...).
// В наборах "НаборыПредметовДляПодписания" лежат документы
// (СправочникСсылка.ДокументыПредприятия). Перед штатным вызовом
// РаботаСЭПКлиент.Подписать документы разворачиваются в файлы, пользователь
// выбирает подписываемые файлы, после чего в наборах документы заменяются на
// выбранные файлы (штатный механизм подпишет именно их).
//
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Имя свойства дополнительных параметров, хранящего признак выполненного
// выбора файлов (маркер исключает повторный показ формы выбора).
//
// Возвращаемое значение:
//  Строка - Имя свойства.
//
Функция Расш_ИмяМаркераВыборВыполнен() Экспорт

	Возврат "Расш_ВыборочноеПодписание_ВыборВыполнен";

КонецФункции

#КонецОбласти

#Область ПерехватИнтеграцияЗадачКлиент

// Перехват ИнтеграцияЗадачКлиент.ОбработатьДанныеВыполнения.
//
// Параметры:
//  КонтекстВыполненияЗадачи - Структура - Контекст выполнения задачи.
//      См. РаботаСЗадачамиКлиент.НовыйКонтекстВыполненияЗадачи.
//  ФормаВладелец - ФормаКлиентскогоПриложения - Владелец вспомогательных форм.
//
// Возвращаемое значение:
//  Булево - Вызвана интерактивная обработка.
//
&Вместо("ОбработатьДанныеВыполнения")
Функция Расш_ОбработатьДанныеВыполнения(КонтекстВыполненияЗадачи, ФормаВладелец) Экспорт

	Если Не Расш_НуженВыборФайловДляПодписания(КонтекстВыполненияЗадачи) Тогда
		Возврат ПродолжитьВызов(КонтекстВыполненияЗадачи, ФормаВладелец);
	КонецЕсли;

	ДополнительныеПараметры = КонтекстВыполненияЗадачи.ДанныеВыполнения.ДополнительныеПараметры;

	НаборыПредметовДляПодписания = Неопределено;
	ДополнительныеПараметры.Свойство("НаборыПредметовДляПодписания", НаборыПредметовДляПодписания);

	ФайлыДляПодписания = Расш_СобратьФайлыДляПодписания(НаборыПредметовДляПодписания);

	Если ФайлыДляПодписания.Количество() <= 1 Тогда
		// Один файл (или ни одного) - близкий к штатному UX, не мешаем.
		Возврат ПродолжитьВызов(КонтекстВыполненияЗадачи, ФормаВладелец);
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Файлы", ФайлыДляПодписания);

	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("КонтекстВыполненияЗадачи", КонтекстВыполненияЗадачи);
	ПараметрыОповещения.Вставить("ФормаВладелец", ФормаВладелец);

	ОписаниеОповещения = Новый ОписаниеОповещения(
		"Расш_ПослеВыбораФайловДляПодписания",
		ЭтотОбъект,
		ПараметрыОповещения);

	ОткрытьФорму(
		"ОбщаяФорма.Расш_ВыборФайловДляПодписания",
		ПараметрыФормы,
		ФормаВладелец,
		КонтекстВыполненияЗадачи.ИдентификаторФормы, , ,
		ОписаниеОповещения);

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет, требуется ли показать форму выборочного подписания файлов.
//
// Параметры:
//  КонтекстВыполненияЗадачи - Структура - Контекст выполнения задачи.
//
// Возвращаемое значение:
//  Булево - Истина, если выполняется подписание предметов ЭП и выбор файлов
//           ещё не выполнен (маркер не установлен).
//
Функция Расш_НуженВыборФайловДляПодписания(КонтекстВыполненияЗадачи)

	ДополнительныеПараметры = КонтекстВыполненияЗадачи.ДанныеВыполнения.ДополнительныеПараметры;

	Если Не ДополнительныеПараметры.Свойство("ПодписатьПредметыЭП")
		Или Не ДополнительныеПараметры.ПодписатьПредметыЭП Тогда

		Возврат Ложь;
	КонецЕсли;

	Если ДополнительныеПараметры.Свойство(Расш_ИмяМаркераВыборВыполнен())
		И ДополнительныеПараметры[Расш_ИмяМаркераВыборВыполнен()] Тогда

		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Собирает плоский уникальный список файлов для выбора, разворачивая
// документы (СправочникСсылка.ДокументыПредприятия) в их файлы.
// Предметы, не являющиеся документами, пропускаются (остаются в наборах
// без изменений).
//
// Параметры:
//  НаборыПредметовДляПодписания - Соответствие, Неопределено -
//      Ключ - ссылка на действие задачи, Значение - Массив предметов.
//
// Возвращаемое значение:
//  Массив из Структура - элементы:
//   * Файл - СправочникСсылка.Файлы - Файл документа.
//   * Документ - СправочникСсылка.ДокументыПредприятия - Документ-владелец файла.
//
Функция Расш_СобратьФайлыДляПодписания(НаборыПредметовДляПодписания)

	ФайлыДляПодписания = Новый Массив;

	Если ТипЗнч(НаборыПредметовДляПодписания) <> Тип("Соответствие") Тогда
		Возврат ФайлыДляПодписания;
	КонецЕсли;

	Для Каждого КлючИЗначение Из НаборыПредметовДляПодписания Цикл

		ПредметыДействия = КлючИЗначение.Значение;
		Если ТипЗнч(ПредметыДействия) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Предмет Из ПредметыДействия Цикл

			Если Не ДелопроизводствоКлиентСервер.ЭтоДокумент(Предмет) Тогда
				Продолжить;
			КонецЕсли;

			ФайлыДокумента = Делопроизводство.ПолучитьФайлыДокументаДляПодписания(Предмет);

			Для Каждого Файл Из ФайлыДокумента Цикл

				Если Расш_ФайлУжеСобран(ФайлыДляПодписания, Файл) Тогда
					Продолжить;
				КонецЕсли;

				ДанныеФайла = Новый Структура;
				ДанныеФайла.Вставить("Файл", Файл);
				ДанныеФайла.Вставить("Документ", Предмет);
				ФайлыДляПодписания.Добавить(ДанныеФайла);

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Возврат ФайлыДляПодписания;

КонецФункции

// Проверяет, добавлен ли уже файл в список для выбора.
//
// Параметры:
//  ФайлыДляПодписания - Массив из Структура - См. Расш_СобратьФайлыДляПодписания.
//  Файл - СправочникСсылка.Файлы - Проверяемый файл.
//
// Возвращаемое значение:
//  Булево - Истина, если файл уже есть в списке.
//
Функция Расш_ФайлУжеСобран(ФайлыДляПодписания, Файл)

	Для Каждого ДанныеФайла Из ФайлыДляПодписания Цикл
		Если ДанныеФайла.Файл = Файл Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Заменяет в наборах предметов документы на выбранные файлы.
// Предметы, не являющиеся документами, сохраняются без изменений.
//
// Параметры:
//  НаборыПредметовДляПодписания - Соответствие - Ключ - действие задачи,
//      Значение - Массив предметов.
//  ВыбранныеФайлы - Массив из Структура - Выбранные файлы:
//   * Файл - СправочникСсылка.Файлы - Выбранный файл.
//   * Документ - СправочникСсылка.ДокументыПредприятия - Документ-владелец файла.
//
Процедура Расш_ЗаменитьДокументыНаВыбранныеФайлы(НаборыПредметовДляПодписания, ВыбранныеФайлы)

	Если ТипЗнч(НаборыПредметовДляПодписания) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КлючИЗначение Из НаборыПредметовДляПодписания Цикл

		ПредметыДействия = КлючИЗначение.Значение;
		Если ТипЗнч(ПредметыДействия) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;

		НовыйНабор = Новый Массив;

		Для Каждого Предмет Из ПредметыДействия Цикл

			Если Не ДелопроизводствоКлиентСервер.ЭтоДокумент(Предмет) Тогда
				НовыйНабор.Добавить(Предмет);
				Продолжить;
			КонецЕсли;

			Для Каждого ВыбранныйФайл Из ВыбранныеФайлы Цикл
				Если ВыбранныйФайл.Документ = Предмет Тогда
					НовыйНабор.Добавить(ВыбранныйФайл.Файл);
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;

		НаборыПредметовДляПодписания.Вставить(КлючИЗначение.Ключ, НовыйНабор);

	КонецЦикла;

КонецПроцедуры

// Обработчик завершения формы выбора файлов для подписания.
//
// Параметры:
//  Результат - Массив из Структура, Неопределено - Выбранные файлы:
//   * Файл - СправочникСсылка.Файлы - Выбранный файл.
//   * Документ - СправочникСсылка.ДокументыПредприятия - Документ-владелец файла.
//   Неопределено - отмена выбора.
//  ПараметрыОповещения - Структура:
//   * КонтекстВыполненияЗадачи - Структура - Контекст выполнения задачи.
//   * ФормаВладелец - ФормаКлиентскогоПриложения - Владелец вспомогательных форм.
//
Процедура Расш_ПослеВыбораФайловДляПодписания(Результат, ПараметрыОповещения) Экспорт

	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		// Отмена: задача остаётся невыполненной, ЭП не формируются.
		Возврат;
	КонецЕсли;

	Если Результат.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрано ни одного файла для подписания.'"));
		Возврат;
	КонецЕсли;

	КонтекстВыполненияЗадачи = ПараметрыОповещения.КонтекстВыполненияЗадачи;
	ФормаВладелец = ПараметрыОповещения.ФормаВладелец;

	ДополнительныеПараметры = КонтекстВыполненияЗадачи.ДанныеВыполнения.ДополнительныеПараметры;

	НаборыПредметовДляПодписания = Неопределено;
	ДополнительныеПараметры.Свойство("НаборыПредметовДляПодписания", НаборыПредметовДляПодписания);

	Расш_ЗаменитьДокументыНаВыбранныеФайлы(НаборыПредметовДляПодписания, Результат);

	ДополнительныеПараметры.Вставить(Расш_ИмяМаркераВыборВыполнен(), Истина);

	ИнтеграцияЗадачКлиент.ОбработатьДанныеВыполнения(КонтекстВыполненияЗадачи, ФормаВладелец);

КонецПроцедуры

#КонецОбласти
