////////////////////////////////////////////////////////////////////////////////
// РАСШИРЕНИЕ: ВыборочноеПодписаниеФайлов.
//
// Общая форма выбора присоединённых файлов документа для выборочного
// подписания ЭП. Заполнение списка выполняется на сервере; выбор и команды -
// на клиенте; криптооперацию выполняет штатный механизм ДО.
//
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Файлы.Очистить();

	МассивФайлов = Неопределено;
	Если Параметры.Свойство("Файлы") Тогда
		МассивФайлов = Параметры.Файлы;
	КонецЕсли;

	Если ТипЗнч(МассивФайлов) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ДанныеФайла Из МассивФайлов Цикл

		Если ТипЗнч(ДанныеФайла) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		ФайлСсылка = ДанныеФайла.Файл;
		Если Не ЗначениеЗаполнено(ФайлСсылка) Тогда
			Продолжить;
		КонецЕсли;

		// Не тянем бинарные данные на клиент: получаем только атрибуты файла.
		ДанныеДляОтображения = РаботаСФайлами.ДанныеФайла(
			ФайлСсылка,
			Новый Структура("ПолучатьСсылкуНаДвоичныеДанные, ВызыватьИсключение", Ложь, Ложь));

		Если ДанныеДляОтображения = Неопределено Тогда
			// Файл недоступен (права/RLS) - пропускаем.
			Продолжить;
		КонецЕсли;

		СтрокаФайла = Файлы.Добавить();
		СтрокаФайла.Выбрано = Истина;
		СтрокаФайла.Файл = ФайлСсылка;
		СтрокаФайла.Документ = ДанныеФайла.Документ;
		СтрокаФайла.Наименование = ДанныеДляОтображения.ИмяФайла;
		СтрокаФайла.Расширение = ДанныеДляОтображения.Расширение;
		СтрокаФайла.Размер = Расш_ПредставлениеРазмераФайла(ДанныеДляОтображения.Размер);
		СтрокаФайла.ПодписанЭП = ДанныеДляОтображения.ПодписанЭП;

	КонецЦикла;

	Элементы.ФайлыДокумент.Видимость = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьВсе(Команда)

	Расш_УстановитьВыбрано(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	Расш_УстановитьВыбрано(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(Команда)

	ФайлСсылка = Расш_ТекущийФайл();
	Если Не ЗначениеЗаполнено(ФайлСсылка) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Выберите файл для открытия.'"));
		Возврат;
	КонецЕсли;

	// Штатный просмотр файла.
	ДанныеФайла = РаботаСФайламиВызовСервера.ДанныеФайлаДляОткрытия(
		ФайлСсылка, Неопределено, УникальныйИдентификатор);
	РаботаСФайламиКлиент.Открыть(ДанныеФайла, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодписи(Команда)

	ФайлСсылка = Расш_ТекущийФайл();
	Если Не ЗначениеЗаполнено(ФайлСсылка) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Выберите файл для проверки подписей.'"));
		Возврат;
	КонецЕсли;

	// Штатный просмотр карточки файла (раздел "Электронные подписи").
	ПоказатьЗначение(, ФайлСсылка);

КонецПроцедуры

&НаКлиенте
Процедура ПодписатьВыбранные(Команда)

	ВыбранныеФайлы = Расш_ВыбранныеФайлы();
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Не выбрано ни одного файла для подписания.'"));
		Возврат;
	КонецЕсли;

	Закрыть(ВыбранныеФайлы);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Расш_УстановитьВыбрано(Значение)

	Для Каждого СтрокаФайла Из Файлы Цикл
		СтрокаФайла.Выбрано = Значение;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция Расш_ТекущийФайл()

	ТекущиеДанные = Элементы.Файлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ТекущиеДанные.Файл;

КонецФункции

&НаКлиенте
Функция Расш_ВыбранныеФайлы()

	Результат = Новый Массив;
	Для Каждого СтрокаФайла Из Файлы Цикл
		Если СтрокаФайла.Выбрано И ЗначениеЗаполнено(СтрокаФайла.Файл) Тогда
			ВыбранныйФайл = Новый Структура;
			ВыбранныйФайл.Вставить("Файл", СтрокаФайла.Файл);
			ВыбранныйФайл.Вставить("Документ", СтрокаФайла.Документ);
			Результат.Добавить(ВыбранныйФайл);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция Расш_ПредставлениеРазмераФайла(Размер)

	Если Размер < 1024 Тогда
		Возврат Строка(Размер) + " " + НСтр("ru = 'байт'");
	ИначеЕсли Размер < 1024 * 1024 Тогда
		Возврат Строка(Окр(Размер / 1024, 1)) + " " + НСтр("ru = 'КБ'");
	Иначе
		Возврат Строка(Окр(Размер / (1024 * 1024), 1)) + " " + НСтр("ru = 'МБ'");
	КонецЕсли;

КонецФункции

#КонецОбласти
