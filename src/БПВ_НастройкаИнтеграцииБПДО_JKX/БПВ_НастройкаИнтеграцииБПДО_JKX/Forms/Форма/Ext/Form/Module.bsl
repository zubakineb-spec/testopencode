&НаКлиенте
Процедура Проверить(Команда)
	ПроверитьНаСервере();
	ПоказатьОповещениеПользователя(ТекстДействий("Проверка выполнена"));
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	ПрименитьНаСервере();
	ПоказатьОповещениеПользователя(ТекстДействий("Настройка применена"));
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуДействий();
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()
	ЗаполнитьТаблицуДействий();
КонецПроцедуры

&НаСервере
Процедура ПрименитьНаСервере()
	Если ЗначениеЗаполнено(АдресВебСервиса) Тогда
		Константы.АдресВебСервиса1СДокументооборот.Установить(АдресВебСервиса);
	КонецЕсли;
	СсылкаПравила = НайтиПравилоИнтеграции();
	Если СсылкаПравила = Неопределено Тогда
		Правило = Справочники.ПравилаИнтеграцииС1СДокументооборотом.СоздатьЭлемент();
		Правило.ТипОбъектаПотребителя = КлючТипОбъектаПотребителя();
		Правило.ТипОбъектаДокументооборота = КлючТипОбъектаДокументооборота();
		ЗаполнитьПравилаЗаполненияРеквизитовПриВыгрузке(Правило);
		ЗаполнитьПравилаЗаполненияРеквизитовПриЗагрузке(Правило);
		Правило.Записать();
	Иначе
		Правило = СсылкаПравила.ПолучитьОбъект();
		Изменено = ЗаполнитьПравилаЗаполненияРеквизитовПриВыгрузке(Правило);
		Если ЗаполнитьПравилаЗаполненияРеквизитовПриЗагрузке(Правило) Тогда
			Изменено = Истина;
		КонецЕсли;
		Если Изменено Тогда
			Правило.Записать();
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьТаблицуДействий();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДействий()
	ТаблицаДействий.Очистить();

	ЗначениеФО = ПолучитьФункциональнуюОпцию("кт_ИспользоватьИнтеграциюС1СДокументооборот");
	ДобавитьДействие("Функциональная опция",
		"кт_ИспользоватьИнтеграциюС1СДокументооборот",
		?(ЗначениеФО, "Включена", "Отключена"),
		"Включена",
		"Только проверка");

	Выборка = ПланыОбмена.ИнтеграцияС1СДокументооборотом.Выбрать();
	КоличествоУзлов = 0;
	Пока Выборка.Следующий() Цикл
		КоличествоУзлов = КоличествоУзлов + 1;
	КонецЦикла;
	ДобавитьДействие("План обмена",
		"ИнтеграцияС1СДокументооборотом",
		"Узлов: " + Строка(КоличествоУзлов),
		"Узлов: " + Строка(КоличествоУзлов),
		"Только проверка");

	СсылкаПравила = НайтиПравилоИнтеграции();
	КоличествоСтрокВыгрузка = МаппингРеквизитовПриВыгрузке().Количество();
	КоличествоСтрокЗагрузка = МаппингРеквизитовПриЗагрузке().Количество();
	Если СсылкаПравила = Неопределено Тогда
		ДобавитьДействие("Правило интеграции",
			КлючТипОбъектаПотребителя() + " -> " + КлючТипОбъектаДокументооборота(),
			"Не найдено",
			"Строк: " + Строка(КоличествоСтрокВыгрузка) + "/" + Строка(КоличествоСтрокЗагрузка)
				+ " (выгрузка/загрузка), ВыгружатьИзменения: Истина, ЗагружатьИзменения: Истина",
			"Будет создано");
	Иначе
		Правило = СсылкаПравила.ПолучитьОбъект();
		КоличествоСтрокВыгрузкаТекущее = Правило.ПравилаЗаполненияРеквизитовПриВыгрузке.Количество();
		КоличествоСтрокЗагрузкаТекущее = Правило.ПравилаЗаполненияРеквизитовПриЗагрузке.Количество();
		ДобавитьДействие("Правило интеграции",
			КлючТипОбъектаПотребителя() + " -> " + КлючТипОбъектаДокументооборота(),
			"Строк: " + Строка(КоличествоСтрокВыгрузкаТекущее) + "/" + Строка(КоличествоСтрокЗагрузкаТекущее)
				+ " (выгрузка/загрузка), ВыгружатьИзменения: " + ПредставлениеБулево(Правило.ВыгружатьИзменения)
				+ ", ЗагружатьИзменения: " + ПредставлениеБулево(Правило.ЗагружатьИзменения),
			"Строк: " + Строка(КоличествоСтрокВыгрузка) + "/" + Строка(КоличествоСтрокЗагрузка)
				+ " (выгрузка/загрузка), ВыгружатьИзменения: Истина, ЗагружатьИзменения: Истина",
			"Будет обновлено");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НайтиПравилоИнтеграции()
	Выборка = Справочники.ПравилаИнтеграцииС1СДокументооборотом.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТипОбъектаПотребителя = КлючТипОбъектаПотребителя()
			И Выборка.ТипОбъектаДокументооборота = КлючТипОбъектаДокументооборота() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция КлючТипОбъектаПотребителя()
	Возврат "Справочник.ДоговорыКонтрагентов";
КонецФункции

&НаСервере
Функция КлючТипОбъектаДокументооборота()
	Возврат "DMInternalDocument";
КонецФункции

&НаСервере
Функция МаппингРеквизитовПриВыгрузке()
	Маппинг = Новый Массив;
	Маппинг.Добавить(СтрокаМаппинга("Владелец", "Контрагент", Истина));
	Маппинг.Добавить(СтрокаМаппинга("Организация", "Организация", Истина));
	Маппинг.Добавить(СтрокаМаппинга("Номер", "РегистрационныйНомер", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("Дата", "ДатаРегистрации", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("СрокДействия", "ДатаОкончанияДействия", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("ВалютаВзаиморасчетов", "Валюта", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("ВидДоговора", "ВидДокумента", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("Комментарий", "Содержание", Ложь));
	Возврат Маппинг;
КонецФункции

&НаСервере
Функция МаппингРеквизитовПриЗагрузке()
	Маппинг = Новый Массив;
	Маппинг.Добавить(СтрокаМаппинга("Номер", "РегистрационныйНомер", Истина));
	Маппинг.Добавить(СтрокаМаппинга("Дата", "ДатаРегистрации", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("СрокДействия", "ДатаОкончанияДействия", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("ВалютаВзаиморасчетов", "Валюта", Ложь));
	Маппинг.Добавить(СтрокаМаппинга("Комментарий", "Содержание", Ложь));
	Возврат Маппинг;
КонецФункции

&НаСервере
Функция СтрокаМаппинга(РеквизитПотребителя, РеквизитДокументооборота, Ключевой)
	Возврат Новый Структура("РеквизитПотребителя, РеквизитДокументооборота, Ключевой",
		РеквизитПотребителя, РеквизитДокументооборота, Ключевой);
КонецФункции

&НаСервере
Функция ЗаполнитьПравилаЗаполненияРеквизитовПриВыгрузке(Правило)
	Изменено = Ложь;
	Для Каждого ЭлементМаппинга Из МаппингРеквизитовПриВыгрузке() Цикл
		СтрокаПравила = НайтиСтрокуМаппинга(Правило, ЭлементМаппинга.РеквизитПотребителя, ЭлементМаппинга.РеквизитДокументооборота);
		Если СтрокаПравила = Неопределено Тогда
			СтрокаПравила = Правило.ПравилаЗаполненияРеквизитовПриВыгрузке.Добавить();
			СтрокаПравила.ИмяРеквизитаОбъектаПотребителя = ЭлементМаппинга.РеквизитПотребителя;
			СтрокаПравила.ИмяРеквизитаОбъектаДокументооборота = ЭлементМаппинга.РеквизитДокументооборота;
			Изменено = Истина;
		КонецЕсли;
		Если СтрокаПравила.ВариантПравилаЗаполненияРеквизитов <> Перечисления.ВариантыПравилЗаполненияРеквизитов.РеквизитОбъекта
			Или СтрокаПравила.ОбновлятьЗначение <> Истина
			Или СтрокаПравила.Ключевой <> ЭлементМаппинга.Ключевой Тогда
			СтрокаПравила.ВариантПравилаЗаполненияРеквизитов = Перечисления.ВариантыПравилЗаполненияРеквизитов.РеквизитОбъекта;
			СтрокаПравила.ОбновлятьЗначение = Истина;
			СтрокаПравила.Ключевой = ЭлементМаппинга.Ключевой;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Изменено;
КонецФункции

&НаСервере
Функция НайтиСтрокуМаппинга(Правило, РеквизитПотребителя, РеквизитДокументооборота)
	Для Каждого СтрокаПравила Из Правило.ПравилаЗаполненияРеквизитовПриВыгрузке Цикл
		Если СтрокаПравила.ИмяРеквизитаОбъектаПотребителя = РеквизитПотребителя
			И СтрокаПравила.ИмяРеквизитаОбъектаДокументооборота = РеквизитДокументооборота Тогда
			Возврат СтрокаПравила;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ЗаполнитьПравилаЗаполненияРеквизитовПриЗагрузке(Правило)
	Изменено = Ложь;
	Для Каждого ЭлементМаппинга Из МаппингРеквизитовПриЗагрузке() Цикл
		СтрокаПравила = НайтиСтрокуМаппингаПриЗагрузке(Правило,
			ЭлементМаппинга.РеквизитПотребителя,
			ЭлементМаппинга.РеквизитДокументооборота);
