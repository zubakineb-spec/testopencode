			СтрокаПравила = Правило.ПравилаЗаполненияРеквизитовПриЗагрузке.Добавить();
			СтрокаПравила.ИмяРеквизитаОбъектаПотребителя = ЭлементМаппинга.РеквизитПотребителя;
			СтрокаПравила.ИмяРеквизитаОбъектаДокументооборота = ЭлементМаппинга.РеквизитДокументооборота;
			Изменено = Истина;
		КонецЕсли;
		Если СтрокаПравила.ВариантПравилаЗаполненияРеквизитов <> Перечисления.ВариантыПравилЗаполненияРеквизитов.РеквизитОбъекта
			Или СтрокаПравила.ОбновлятьЗначение <> Истина
			Или СтрокаПравила.Ключевой <> ЭлементМаппинга.Ключевой Тогда
			СтрокаПравила.ВариантПравилаЗаполненияРеквизитов = Перечисления.ВариантыПравилЗаполненияРеквизитов.РеквизитОбъекта;
			СтрокаПравила.ОбновлятьЗначение = Истина;
			СтрокаПравила.Ключевой = ЭлементМаппинга.Ключевой;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Изменено;
КонецФункции

&НаСервере
Функция НайтиСтрокуМаппингаПриЗагрузке(Правило, РеквизитПотребителя, РеквизитДокументооборота)
	Для Каждого СтрокаПравила Из Правило.ПравилаЗаполненияРеквизитовПриЗагрузке Цикл
		Если СтрокаПравила.ИмяРеквизитаОбъектаПотребителя = РеквизитПотребителя
			И СтрокаПравила.ИмяРеквизитаОбъектаДокументооборота = РеквизитДокументооборота Тогда
			Возврат СтрокаПравила;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ПредставлениеБулево(Значение)
	Возврат ?(Значение, "Истина", "Ложь");
КонецФункции

&НаСервере
Процедура ДобавитьДействие(Объект, Операция, Текущее, Будет, Статус)
	СтрокаДействия = ТаблицаДействий.Добавить();
	СтрокаДействия.Объект = Объект;
	СтрокаДействия.Операция = Операция;
	СтрокаДействия.Текущее = Текущее;
	СтрокаДействия.Будет = Будет;
	СтрокаДействия.Статус = Статус;
КонецПроцедуры

&НаКлиенте
Функция ТекстДействий(Заголовок)
	Текст = Заголовок + ":";
	Для Каждого СтрокаДействия Из ТаблицаДействий Цикл
		Текст = Текст + Символы.ПС + СтрокаДействия.Объект + ": " + СтрокаДействия.Статус;
	КонецЦикла;
	Возврат Текст;
КонецФункции
